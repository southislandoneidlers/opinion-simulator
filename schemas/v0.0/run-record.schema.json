{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opinion-simulator.local/schemas/v0.0/run-record.schema.json",
  "title": "Opinion Simulator Run Record",
  "type": "object",
  "required": ["schemaVersion", "runId", "projectId", "kind", "status", "createdAt", "startedAt", "completedAt", "skillVersion", "executionPlan", "samples", "stabilityComparison", "synthesisAttribution", "report", "integrity"],
  "properties": {
    "schemaVersion": {"const": "0.0"},
    "runId": {"type": "string"},
    "projectId": {"type": "string"},
    "kind": {"enum": ["persona-simulation", "synthesis"]},
    "status": {"enum": ["completed", "partially-completed", "failed"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "skillVersion": {"type": "string"},
    "executionPlan": {
      "type": "object",
      "required": ["sourceRefs", "personaRefs", "questionSet", "promptTemplate", "renderedPromptSections", "provider", "model", "endpointClass", "settings", "sampleCount", "sampleIds", "truncation", "estimate", "preflightApproval", "planHash"],
      "properties": {
        "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "personaRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "questionSet": {"type": "object"},
        "promptTemplate": {"type": "object"},
        "renderedPromptSections": {"type": "object"},
        "provider": {"enum": ["agent-host", "gemini"]},
        "model": {"type": "string", "minLength": 1},
        "endpointClass": {"type": "string", "minLength": 1},
        "settings": {"type": "object"},
        "sampleCount": {"enum": [1, 3]},
        "sampleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "truncation": {"type": "object"},
        "estimate": {"type": "object"},
        "preflightApproval": {"type": "object"},
        "planHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "selectedResults": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sampleId", "personaRef", "status", "attemptEvents", "normalizedRequest", "normalizedResponse", "rawProviderResponse", "parsedResult", "validationWarnings", "providerUsage", "startedAt", "completedAt", "latencyMs"],
        "properties": {
          "sampleId": {"type": "string"},
          "personaRef": {"type": "object"},
          "status": {"enum": ["completed", "partial", "failed"]},
          "attemptEvents": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "normalizedRequest": {"type": "object"},
          "normalizedResponse": {"type": "object"},
          "rawProviderResponse": {},
          "parsedResult": {
            "oneOf": [
              {"$ref": "result.schema.json"},
              {"$ref": "synthesis-result.schema.json"}
            ]
          },
          "validationWarnings": {"type": "array", "items": {"type": "string"}},
          "providerUsage": {"type": "object"},
          "startedAt": {"type": "string", "format": "date-time"},
          "completedAt": {"type": "string", "format": "date-time"},
          "latencyMs": {"type": "integer"}
        },
        "additionalProperties": false
      }
    },
    "stabilityComparison": {"type": "object"},
    "synthesisAttribution": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["selectedSampleIds", "selectedPersonaVersionIds", "originalRefs"],
          "properties": {
            "selectedSampleIds": {"type": "array", "minItems": 2, "items": {"type": "string"}},
            "selectedPersonaVersionIds": {"type": "array", "minItems": 2, "items": {"type": "string"}},
            "originalRefs": {"type": "array", "minItems": 2, "items": {"type": "object"}}
          },
          "additionalProperties": false
        }
      ]
    },
    "report": {"type": "object"},
    "integrity": {"type": "object"}
  },
  "additionalProperties": false
}
